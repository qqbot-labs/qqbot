[Unit]
Description=QQ Whale private daily data backup

[Service]
Type=oneshot
User=qqwhale
Group=qqwhale
Environment=HOME=/home/qqwhale
Environment=DSH_HOME=/home/qqwhale/.dsh
Environment=WHALE_ROOT=/home/qqwhale/whale
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
PrivateDevices=yes
RestrictNamespaces=yes
ReadWritePaths=/home/qqwhale/whale/backups
BindPaths=/home/qqwhale/whale/etc/private-null:/dev/null
StandardInput=data
StandardInputData=AA==
ExecStart=/home/qqwhale/whale/bin/whale-backup.sh
TimeoutStartSec=10min
CPUQuota=20%
MemoryMax=256M

