limit_req_zone $binary_remote_addr zone=whale_admin_login:1m rate=6r/m;
limit_req_zone $server_name zone=whale_admin_login_total:1m rate=12r/m;
server {
    listen 80;
    server_name whale.example.com;
    root /var/www/acme;
    location ^~ /.well-known/acme-challenge/ { default_type text/plain; try_files $uri =404; }
    location / { return 301 https://whale.example.com$request_uri; }
}
server {
    listen 443 ssl http2;
    server_name whale.example.com;
    ssl_certificate /etc/letsencrypt/live/whale.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/whale.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    add_header Strict-Transport-Security "max-age=31536000" always;
    client_max_body_size 512k;
    limit_req_status 429;
    proxy_http_version 1.1;
    proxy_set_header Host whale.example.com;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Host "";
    proxy_read_timeout 125s;
    proxy_send_timeout 125s;
    location = /api/login {
        limit_req zone=whale_admin_login burst=4 nodelay;
        limit_req zone=whale_admin_login_total burst=8 nodelay;
        proxy_pass http://127.0.0.1:3090;
    }
    location / { proxy_pass http://127.0.0.1:3090; }
}
